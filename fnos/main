#!/bin/bash

node=""
server="${TRIM_APPDEST:?}/server.js"
var="${TRIM_PKGVAR:?}"
pidfile="$var/app.pid"
port="${TRIM_SERVICE_PORT:-8787}"
socket="${TRIM_APPDEST}/app.sock"
share=${TRIM_DATA_SHARE_PATHS:-}
data=${share%%:*}
if [ -z "$data" ] && [ -d /var/apps/iptv-manager/shares/data ]; then
    data=/var/apps/iptv-manager/shares/data
fi
data=${data:-$var/data}

find_node() {
    local candidate major best=21
    for candidate in /var/apps/nodejs_v*/target/bin/node /var/apps/nodejs/target/bin/node "$(command -v node || true)"; do
        [ -x "$candidate" ] || continue
        major=$("$candidate" -p 'process.versions.node.split(".")[0]' 2>/dev/null) || continue
        [[ "$major" =~ ^[0-9]+$ ]] || continue
        if (( major > best )); then
            best=$major
            node=$candidate
        fi
    done
    [ -n "$node" ]
}

running() {
    [ -r "$pidfile" ] || return 1
    read -r pid < "$pidfile"
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] && [ -r "/proc/$pid/cmdline" ] &&
        grep -Fxq -- "$server" < <(tr '\0' '\n' < "/proc/$pid/cmdline")
}

fail() {
    echo "$*" >&2
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$*" > "$TRIM_TEMP_LOGFILE"
    fi
    exit 1
}

case "${1:-}" in
    start)
        running && exit 0
        find_node || fail "需要 Node.js v22 或更高版本，请先在飞牛应用中心安装 Node.js。"
        mkdir -p "$data" || fail "Cannot create the IPTV data directory"
        if [ "$data" != "$var/data" ] && [ ! -e "$data/settings.json" ] && [ -f "$var/data/settings.json" ]; then
            if [ -d "$var/data/epg" ]; then
                cp -Rn -- "$var/data/epg" "$data/" || fail "Cannot migrate IPTV EPG cache"
            fi
            cp -- "$var/data/settings.json" "$data/.settings-migration.tmp" &&
                mv -n -- "$data/.settings-migration.tmp" "$data/settings.json" || fail "Cannot migrate IPTV settings"
        fi
        if [ -S "$socket" ]; then rm -f -- "$socket" || fail "Cannot remove stale gateway socket"; fi
        PORT="$port" DATA_DIR="$data" FNOS_SOCKET="$socket" nohup "$node" "$server" > "$var/app.log" 2>&1 < /dev/null &
        pid=$!
        printf '%s\n' "$pid" > "$pidfile"
        for ((attempt=0; attempt<10; attempt++)); do
            sleep 1
            running || fail "IPTV failed to start. See $var/app.log"
            if [ -S "$socket" ] && "$node" -e 'fetch("http://127.0.0.1:" + process.argv[1] + "/playlist.m3u", {signal: AbortSignal.timeout(800)}).then(response => { if (!response.ok) process.exitCode = 1; return response.body.cancel(); }).catch(() => process.exitCode = 1)' "$port"; then
                exit 0
            fi
        done
        kill -TERM "$pid"
        fail "IPTV did not become ready. See $var/app.log"
        ;;
    stop)
        if running; then
            kill -TERM "$pid" || fail "Unable to stop IPTV"
            for ((attempt=0; attempt<10; attempt++)); do
                running || break
                sleep 1
            done
            if running; then kill -KILL "$pid" || fail "Unable to stop IPTV"; fi
        fi
        rm -f -- "$pidfile"
        if [ -S "$socket" ]; then rm -f -- "$socket"; fi
        ;;
    status)
        running && exit 0
        exit 3
        ;;
    *) exit 1 ;;
esac
